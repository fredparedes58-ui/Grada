# Firebase (público por diseño — la seguridad la dan las reglas de Firestore/Storage)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Anthropic — SOLO en Vercel, NUNCA con prefijo VITE_
# Revoca la clave vieja en console.anthropic.com antes de crear esta
ANTHROPIC_API_KEY=

# Firebase project id para validar tokens en api/claude.js
FIREBASE_PROJECT_ID=

# Orígenes CORS permitidos en api/claude.js (coma-separados)
ORIGENES_PERMITIDOS=https://tu-dominio.vercel.app,http://localhost:5173
